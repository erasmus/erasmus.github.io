---
import { getCollection } from 'astro:content';
import BentoTile from './BentoTile.astro';
const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---
<div class="bento wide-width">
  {projects.map((p) => <BentoTile project={p} />)}
</div>
<style>
  .bento { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; grid-auto-flow: dense; }
  @media (max-width: 899.98px) { .bento { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 599.98px) { .bento { grid-template-columns: 1fr; } }
</style>
