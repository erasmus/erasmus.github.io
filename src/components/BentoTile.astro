---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const { title, tile, image, span, domain, years, summary } = project.data;
---
<a href={`/projects/${project.id}/`} class={`tile tile-${tile} span-${span}`}>
  {tile === 'image' && image && (
    <Image src={image} alt="" widths={[400, 800, 1200]} sizes="(max-width: 600px) 100vw, 50vw" />
  )}
  {tile === 'logo' && image && (
    <div class="logo-panel"><Image src={image} alt="" width={120} height={120} /></div>
  )}
  <div class="tile-text">
    <h3>{title}</h3>
    <p class="label">{domain} · {years}</p>
    {span !== 'sm' && (
      <div class="summary-wrap"><p class="summary">{summary}</p></div>
    )}
  </div>
</a>
<style>
  .tile { display: flex; flex-direction: column; text-decoration: none; border: 1px solid var(--rule); background: var(--tile); transition: background-color 150ms ease-out, border-color 150ms ease-out, transform 200ms ease-out, box-shadow 200ms ease-out; overflow: hidden; }
  .tile:hover { background: rgba(31, 30, 29, 0.08); border-color: var(--ink); transform: translateY(-3px); box-shadow: 0 12px 24px -14px rgba(31, 30, 29, 0.35); }
  .tile :global(img) { width: 100%; object-fit: cover; flex: 1; min-height: 0; }
  .tile-image :global(img) { transition: transform 400ms ease-out; }
  .tile-image:hover :global(img) { transform: scale(1.04); }
  .logo-panel { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .tile-text { padding: 14px 16px 16px; }
  .tile-text h3 { font-size: 1.15rem; }
  .tile-text .summary { font-size: 0.85rem; color: var(--ink-muted); margin-top: 4px; }
  /* Summaries stay collapsed so the grid reads as images and titles; hovering a
     tile (or keyboard-focusing it) rolls the detail open. Touch devices keep it
     visible since they have no hover state. */
  @media (hover: hover) {
    .summary-wrap { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 250ms ease-out, opacity 200ms ease-out; }
    .summary-wrap > .summary { overflow: hidden; margin-top: 0; padding-top: 4px; }
    .tile:hover .summary-wrap, .tile:focus-visible .summary-wrap { grid-template-rows: 1fr; opacity: 1; }
  }
  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .summary-wrap { transition: none; }
  }
  .span-lg .tile-text h3 { font-size: 1.5rem; }
  @media (min-width: 900px) {
    .span-md { grid-column: span 2; }
    .span-lg { grid-column: span 2; grid-row: span 2; }
    /* Widest tile reads as a banner: logo left, title and summary beside it. */
    .span-xl { grid-column: span 3; flex-direction: row; align-items: stretch; }
    .span-xl .logo-panel { flex: 0 0 34%; border-right: 1px solid var(--rule); }
    .span-xl .logo-panel :global(img) { width: auto; max-width: 100%; max-height: 100%; flex: none; object-fit: contain; }
    .span-xl .tile-text { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 24px 32px; }
    .span-xl .tile-text h3 { font-size: 1.5rem; }
    .span-xl .tile-text .summary { font-size: 0.95rem; margin-top: 8px; max-width: 42em; }
  }
  @media (hover: hover) and (min-width: 900px) {
    .span-xl .summary-wrap > .summary { padding-top: 8px; }
  }
  @media (min-width: 600px) and (max-width: 899.98px) {
    .span-lg, .span-xl { grid-column: span 2; }
  }
</style>
