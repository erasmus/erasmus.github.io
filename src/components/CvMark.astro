---
// Logo mark for a CV entry. `icon` is a filename in src/assets/icons; when it is
// missing (or the file is not there yet) we fall back to an initial monogram, so
// a role can ship before its logo does.
interface Props { icon?: string; name: string }
const { icon, name } = Astro.props;
const files = import.meta.glob<string>('../assets/icons/*.svg', {
  eager: true,
  query: '?url',
  import: 'default',
});
const src = icon ? files[`../assets/icons/${icon}`] : undefined;
---
{src
  ? <img class="mark" src={src} alt="" aria-hidden="true" />
  : <span class="mark monogram" aria-hidden="true">{name.charAt(0)}</span>}
<style>
  /* Logos sit in the monochrome palette by default; brand colour on hover of the
     surrounding entry (see .org:hover in CvSection). */
  .mark {
    height: 22px; width: auto; max-width: 108px; object-fit: contain; object-position: left center; flex: none;
    filter: grayscale(1) brightness(0.55) contrast(1.1);
    opacity: 0.8;
    transition: filter 150ms ease-out, opacity 150ms ease-out;
  }
  .monogram {
    height: 22px; width: 22px; display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--rule); color: var(--ink-muted);
    font-family: var(--font-sans); font-size: 11px; font-weight: 600;
  }
</style>
