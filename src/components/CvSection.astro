---
import { CV } from '../data/cv';
import CvMark from './CvMark.astro';
import CvLogo from './CvLogo.astro';
interface Props { full?: boolean }
const { full = false } = Astro.props;
// The home page shows only the four most recent roles, one per organisation, with
// logo marks; /cv/ renders the complete history as plain text.
const experience = full
  ? CV.experience
  : CV.experience.slice(0, 4).map((o) => ({ ...o, positions: o.positions.slice(0, 1) }));
const education = full ? CV.education : CV.education.slice(0, 3);
const Heading = full ? 'h1' : 'h2';
---
<section id="cv" class="prose-width" aria-labelledby="cv-heading">
  <Heading id="cv-heading">{full ? 'Curriculum vitae' : 'CV'}</Heading>
  <h3 class="label">Experience</h3>
  {experience.map((o) => (
    <div class="org">
      <h4>{full
        ? o.org
        : o.logo
          ? <CvLogo logo={o.logo} name={o.org} />
          : <><CvMark icon={o.icon} name={o.org} />{o.org}</>}</h4>
      {o.positions.map((p) => (
        <div class="position">
          <p class="title-line"><span class="title">{p.title}</span><span class="label dates">{p.dates}</span></p>
          {full && p.note && <p class="note">{p.note}</p>}
        </div>
      ))}
    </div>
  ))}
  <h3 class="label">Education</h3>
  {education.map((e) => (
    <div class="org">
      <h4>{full
        ? e.institution
        : e.logo
          ? <CvLogo logo={e.logo} name={e.institution} />
          : <><CvMark icon={e.icon} name={e.institution} />{e.institution}</>}</h4>
      <div class="position">
        <p class="title-line"><span class="title">{e.qualification}</span><span class="label dates">{e.years}</span></p>
        {full && e.note && <p class="note">{e.note}</p>}
      </div>
    </div>
  ))}
  {full && (
    <>
      <h3 class="label">Languages</h3>
      <p class="note">{CV.languages.join(' · ')}</p>
    </>
  )}
  {!full &&<p class="more"><a class="more-link" href="/cv/">Full curriculum →</a></p>}
</section>
<style>
  section h2 { font-size: 1.7rem; }
  section h1 { font-size: 2.2rem; }
  section h3.label { margin-top: 2em; padding-bottom: 6px; border-bottom: 1px solid var(--rule); }
  .org { margin-top: 1.2em; }
  /* Org outranks the role beneath it: Newsreader reads optically smaller than the
     Palatino body text, so 1.1rem left it looking like a subheading of the role. */
  .org h4 { font-size: 1.4rem; display: flex; align-items: center; gap: 10px; }
  .position { margin-top: 0.4em; }
  .title-line { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .note { color: var(--ink-muted); font-size: 0.9rem; margin-top: 2px; }
  .more { margin-top: 2em; }
</style>
