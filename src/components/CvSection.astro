---
import { CV, HOME_MERGED_ORGS } from '../data/cv';
import CvMark from './CvMark.astro';
import CvLogo from './CvLogo.astro';
interface Props { full?: boolean }
const { full = false } = Astro.props;
// The home page shows only the three most recent entries, one role per organisation,
// with logo marks; /cv/ renders the complete history as plain text. An entry can carry
// more than one organisation: SatoshiPay and Pendulum are the same org under two
// brands, so the home page folds them into one entry showing both wordmarks.
const merged = HOME_MERGED_ORGS
  .map((name) => CV.experience.find((o) => o.org === name))
  .filter((o) => o !== undefined);
// The folded entry takes the slot of whichever brand comes first in the history.
const mergeSlot = CV.experience.find((o) => HOME_MERGED_ORGS.includes(o.org));
const experience = full
  ? CV.experience.map((o) => ({ orgs: [o], positions: o.positions }))
  : CV.experience
      .flatMap((o) => {
        if (!HOME_MERGED_ORGS.includes(o.org)) return [{ orgs: [o], positions: o.positions.slice(0, 1) }];
        return o === mergeSlot ? [{ orgs: merged, positions: merged[0].positions.slice(0, 1) }] : [];
      })
      .slice(0, 3);
const education = full ? CV.education : CV.education.slice(0, 3);
const Heading = full ? 'h1' : 'h2';
---
<section id="cv" class="prose-width" aria-labelledby="cv-heading">
  <Heading id="cv-heading">{full ? 'Curriculum vitae' : 'CV'}</Heading>
  {full && <p class="cv-plain"><a href="/cv.txt">Plain-text version</a></p>}
  <h3 class="label">Experience</h3>
  {experience.map((e) => (
    <div class="org">
      <h4>{full
        ? e.orgs[0].org
        : e.orgs.map((o) => (o.logo
          ? <CvLogo logo={o.logo} name={o.org} />
          : <><CvMark icon={o.icon} name={o.org} />{o.org}</>))}</h4>
      {e.positions.map((p) => (
        <div class="position">
          <p class="title-line"><span class="title">{p.title}</span><span class="label dates">{p.dates}</span></p>
          {full && p.note && <p class="note">{p.note}</p>}
        </div>
      ))}
    </div>
  ))}
  <h3 class="label">Education</h3>
  <div class={full ? undefined : 'edu-row'}>
  {education.map((e) => (
    <div class="org">
      <h4>{full
        ? e.institution
        : e.logo
          ? <CvLogo logo={e.logo} name={e.institution} />
          : <><CvMark icon={e.icon} name={e.institution} />{e.institution}</>}</h4>
      {full && (
        <div class="position">
          <p class="title-line"><span class="title">{e.qualification}</span><span class="label dates">{e.years}</span></p>
          {e.note && <p class="note">{e.note}</p>}
        </div>
      )}
    </div>
  ))}
  </div>
  {full && (
    <>
      <h3 class="label">Languages</h3>
      <p class="note">{CV.languages.join(' · ')}</p>
    </>
  )}
  {!full &&<p class="more"><a class="more-link" href="/cv/">Full curriculum →</a></p>}
</section>
<style>
  section h2 { font-size: 1.7rem; }
  section h1 { font-size: 2.2rem; }
  section h3.label { margin-top: 2em; padding-bottom: 6px; border-bottom: 1px solid var(--rule); }
  .cv-plain { margin-top: 6px; font-size: 0.85em; color: var(--ink-muted); }
  .cv-plain a { color: inherit; }
  .org { margin-top: 1.2em; }
  /* Home page: the education entries are bare wordmarks, so they sit on one line
     instead of each claiming a stacked block of their own. The three marks total
     ~295px at full size, which overflows the prose column on phones, so they shrink
     together rather than wrapping one mark onto a lonely second row. */
  .edu-row { display: flex; align-items: center; gap: 28px; }
  .edu-row .org { margin-top: 1.2em; }
  @media (max-width: 599.98px) {
    .edu-row { --logo-scale: 0.78; gap: clamp(12px, 5vw, 20px); }
  }
  /* Org outranks the role beneath it: Newsreader reads optically smaller than the
     Palatino body text, so 1.1rem left it looking like a subheading of the role. */
  .org h4 { font-size: 1.4rem; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .position { margin-top: 0.4em; }
  .title-line { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .note { color: var(--ink-muted); font-size: 0.9rem; margin-top: 2px; }
  .more { margin-top: 2em; }
</style>
