---
// Small line illustrations for the library cards, drawn in the site's ink on
// a 320x200 canvas. Colour is kept for the one bookmark that is about colour.
// Each picture has a little hover move, driven from the card in library/index.
import type { LibraryArt } from '../data/library';
interface Props { art: LibraryArt }
const { art } = Astro.props;

// A 21x21 QR-ish field: real finder patterns in three corners, seeded noise
// for the data modules so the picture is the same on every build.
const QR_N = 21;
const QR_M = 7;
const qrX = (320 - QR_N * QR_M) / 2;
const qrY = (200 - QR_N * QR_M) / 2;
const inFinder = (r: number, c: number) =>
  (r < 8 && c < 8) || (r < 8 && c >= QR_N - 8) || (r >= QR_N - 8 && c < 8);
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const qrDots: { x: number; y: number }[] = [];
for (let r = 0; r < QR_N; r++) {
  for (let c = 0; c < QR_N; c++) {
    if (inFinder(r, c)) continue;
    if (rand() < 0.48) qrDots.push({ x: qrX + c * QR_M + QR_M / 2, y: qrY + r * QR_M + QR_M / 2 });
  }
}
const finders = [
  [qrX, qrY],
  [qrX + (QR_N - 7) * QR_M, qrY],
  [qrX, qrY + (QR_N - 7) * QR_M],
];

// Sine wave across the canvas for the electric card.
const wave = Array.from({ length: 81 }, (_, i) => {
  const x = -40 + i * 5;
  return `${i ? 'L' : 'M'}${x} ${100 + Math.sin(i / 4) * 34}`;
}).join(' ');

// The agency grid: a field of dots the arrow cuts straight through.
const grid = Array.from({ length: 6 * 10 }, (_, i) => ({ x: 52 + (i % 10) * 24, y: 46 + Math.floor(i / 10) * 22 }));

// The Omarchy wordmark, traced from its pixel grid (src/assets/icons) into
// one outline path: seven letters plus the counters of O, A and R.
const OMARCHY = 'M224 71.2 L224 84.7 L220.5 84.7 L220.5 88.1 L217 88.1 L217 91.5 L213.6 91.5 L213.6 78 L203.2 78 L203.2 118.6 L213.6 118.6 L213.6 105.1 L217 105.1 L217 108.5 L220.5 108.5 L220.5 111.9 L224 111.9 L224 118.6 L220.5 118.6 L220.5 122 L217 122 L217 125.4 L192.8 125.4 L192.8 78 L196.3 78 L196.3 74.6 L199.8 74.6 L199.8 71.2 Z M230.9 78 L234.3 78 L234.3 74.6 L237.8 74.6 L237.8 71.2 L241.2 71.2 L241.2 94.9 L251.6 94.9 L251.6 71.2 L255.1 71.2 L255.1 74.6 L258.5 74.6 L258.5 78 L262 78 L262 94.9 L265.4 94.9 L265.4 98.3 L262 98.3 L262 118.6 L258.5 118.6 L258.5 122 L255.1 122 L255.1 125.4 L251.6 125.4 L251.6 101.7 L241.2 101.7 L241.2 125.4 L230.9 125.4 L230.9 101.7 L224 101.7 L224 98.3 L227.4 98.3 L227.4 94.9 L230.9 94.9 Z M89.1 67.8 L89.1 71.2 L103 71.2 L103 74.6 L106.4 74.6 L106.4 78 L109.9 78 L109.9 118.6 L106.4 118.6 L106.4 122 L103 122 L103 125.4 L99.5 125.4 L99.5 78 L89.1 78 L89.1 125.4 L78.8 125.4 L78.8 78 L68.4 78 L68.4 125.4 L64.9 125.4 L64.9 122 L61.5 122 L61.5 118.6 L58 118.6 L58 78 L61.5 78 L61.5 74.6 L64.9 74.6 L64.9 71.2 L78.8 71.2 L78.8 67.8 Z M165.2 78 L165.2 94.9 L175.6 94.9 L175.6 78 Z M51.1 118.6 L47.7 118.6 L47.7 122 L44.2 122 L44.2 125.4 L26.9 125.4 L26.9 122 L23.5 122 L23.5 118.6 L20 118.6 L20 78 L23.5 78 L23.5 74.6 L26.9 74.6 L26.9 71.2 L44.2 71.2 L44.2 74.6 L47.7 74.6 L47.7 78 L51.1 78 Z M279.3 94.9 L289.6 94.9 L289.6 71.2 L293.1 71.2 L293.1 74.6 L296.5 74.6 L296.5 78 L300 78 L300 118.6 L296.5 118.6 L296.5 122 L293.1 122 L293.1 125.4 L275.8 125.4 L275.8 122 L272.3 122 L272.3 118.6 L268.9 118.6 L268.9 108.5 L272.3 108.5 L272.3 105.1 L279.3 105.1 L279.3 118.6 L289.6 118.6 L289.6 101.7 L268.9 101.7 L268.9 78 L272.3 78 L272.3 74.6 L275.8 74.6 L275.8 71.2 L279.3 71.2 Z M165.2 105.1 L185.9 105.1 L185.9 125.4 L182.5 125.4 L182.5 128.8 L179 128.8 L179 132.2 L175.6 132.2 L175.6 111.9 L165.2 111.9 L165.2 132.2 L154.8 132.2 L154.8 111.9 L151.4 111.9 L151.4 105.1 L154.8 105.1 L154.8 101.7 L151.4 101.7 L151.4 94.9 L154.8 94.9 L154.8 78 L158.3 78 L158.3 74.6 L161.7 74.6 L161.7 71.2 L185.9 71.2 L185.9 94.9 L182.5 94.9 L182.5 98.3 L179 98.3 L179 101.7 L165.2 101.7 Z M30.4 78 L30.4 118.6 L40.7 118.6 L40.7 78 Z M137.5 78 L127.2 78 L127.2 94.9 L137.5 94.9 Z M137.5 101.7 L127.2 101.7 L127.2 125.4 L116.8 125.4 L116.8 101.7 L113.3 101.7 L113.3 94.9 L116.8 94.9 L116.8 78 L120.2 78 L120.2 74.6 L123.7 74.6 L123.7 71.2 L147.9 71.2 L147.9 118.6 L144.4 118.6 L144.4 122 L141 122 L141 125.4 L137.5 125.4 Z';
---
<svg class={`art art-${art}`} viewBox="0 0 320 200" aria-hidden="true" focusable="false">
  {art === 'color' && (
    <g class="swatches">
      <g class="sw sw-1"><rect x="74" y="44" width="92" height="120" fill="#D2603A" /><rect x="74" y="140" width="92" height="24" fill="#F0EEE6" opacity="0.9" /></g>
      <g class="sw sw-2"><rect x="114" y="36" width="92" height="120" fill="#E5BC6A" /><rect x="114" y="132" width="92" height="24" fill="#F0EEE6" opacity="0.9" /></g>
      <g class="sw sw-3"><rect x="154" y="28" width="92" height="120" fill="#355A6E" /><rect x="154" y="124" width="92" height="24" fill="#F0EEE6" opacity="0.9" /></g>
      <rect x="164" y="133" width="30" height="5" fill="#355A6E" opacity="0.6" />
      <rect x="198" y="133" width="18" height="5" fill="#355A6E" opacity="0.3" />
    </g>
  )}

  {art === 'color-tree' && (
    <g class="lineage">
      <g fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.6">
        <path d="M160 52 V76 M84 76 H236 M84 76 V100 M160 76 V100 M236 76 V100" />
        <path d="M84 124 V140 M60 140 H108 M60 140 V156 M108 140 V156" />
        <path d="M236 124 V140 M212 140 H260 M212 140 V156 M260 140 V156" />
      </g>
      <g class="gen gen-0"><rect x="142" y="18" width="36" height="36" fill="#8C3B2E" /></g>
      <g class="gen gen-1">
        <rect x="68" y="100" width="32" height="24" fill="#B5543F" />
        <rect x="144" y="100" width="32" height="24" fill="#6E3A4A" />
        <rect x="220" y="100" width="32" height="24" fill="#C9874E" />
      </g>
      <g class="gen gen-2">
        <rect x="48" y="156" width="24" height="18" fill="#D98A70" />
        <rect x="96" y="156" width="24" height="18" fill="#E8B7A0" />
        <rect x="200" y="156" width="24" height="18" fill="#E2B36C" />
        <rect x="248" y="156" width="24" height="18" fill="#EFD3A4" />
      </g>
    </g>
  )}

  {art === 'cable' && (
    <g class="cable">
      <g fill="none" stroke="currentColor" stroke-width="1" opacity="0.4">
        <path d="M44 46 q 10 -5 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 12 0" />
      </g>
      <path d="M0 40 H46 V200 H0 Z" fill="currentColor" opacity="0.12" />
      <path d="M274 40 H320 V200 H274 Z" fill="currentColor" opacity="0.12" />
      <path d="M46 40 V200 M274 40 V200" stroke="currentColor" stroke-width="1.5" />
      <path d="M46 150 C 80 150, 90 176, 130 176 S 200 168, 230 174 S 262 150, 274 150" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4" />
      <path class="line" d="M24 70 V100 C 60 100, 80 160, 130 164 S 210 156, 240 162 S 270 100, 296 100 V70" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
      <path class="pulse" d="M24 70 V100 C 60 100, 80 160, 130 164 S 210 156, 240 162 S 270 100, 296 100 V70" fill="none" stroke="var(--paper)" stroke-width="1" stroke-dasharray="6 18" />
      <g fill="var(--paper)" stroke="currentColor" stroke-width="1.5">
        <circle cx="130" cy="164" r="5" /><circle cx="196" cy="160" r="5" />
      </g>
      <g fill="currentColor"><rect x="16" y="58" width="16" height="12" /><rect x="288" y="58" width="16" height="12" /></g>
    </g>
  )}

  {art === 'orbit' && (
    <g class="orbit">
      <path d="M-20 200 Q 160 128, 340 200" fill="currentColor" opacity="0.1" />
      <path d="M-20 200 Q 160 128, 340 200" fill="none" stroke="currentColor" stroke-width="1.5" />
      <ellipse cx="160" cy="150" rx="150" ry="62" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4 5" opacity="0.5" />
      {[[40, 30], [282, 40], [210, 22], [24, 120], [300, 120]].map(([x, y]) => <circle cx={x} cy={y} r="1.5" fill="currentColor" opacity="0.5" />)}
      <g class="sat">
        <g fill="none" stroke="currentColor" stroke-width="1.25">
          <rect x="90" y="78" width="46" height="26" /><path d="M105.3 78 V104 M120.6 78 V104 M90 91 H136" />
          <rect x="184" y="78" width="46" height="26" /><path d="M199.3 78 V104 M214.6 78 V104 M184 91 H230" />
          <path d="M136 91 H146 M174 91 H184" />
        </g>
        <rect x="146" y="70" width="28" height="42" fill="var(--paper)" stroke="currentColor" stroke-width="2" />
        <g stroke="currentColor" stroke-width="1.5"><path d="M151 80 H169 M151 88 H169 M151 96 H169" /></g>
        <g fill="currentColor"><circle cx="153" cy="104" r="1.6" /><circle cx="158" cy="104" r="1.6" /></g>
      </g>
    </g>
  )}

  {art === 'qr' && (
    <g class="qr">
      {finders.map(([x, y]) => (
        <g>
          <rect x={x + 1.5} y={y + 1.5} width={QR_M * 7 - 3} height={QR_M * 7 - 3} rx="10" fill="none" stroke="currentColor" stroke-width="3" />
          <rect x={x + 14} y={y + 14} width={QR_M * 3 - 7} height={QR_M * 3 - 7} rx="5" fill="currentColor" />
        </g>
      ))}
      {qrDots.map((d, i) => <circle class="qr-dot" style={`--i:${i % 9}`} cx={d.x} cy={d.y} r="2.6" fill="currentColor" />)}
    </g>
  )}

  {art === 'svg' && (
    <g class="vector" fill="none" stroke="currentColor">
      <g class="cruft" stroke-width="1" opacity="0.35">
        <path d="M40 150 l8 -6 l5 3 l7 -9 l4 2 l6 -8 l5 1" />
        <circle cx="54" cy="58" r="2" fill="currentColor" stroke="none" />
        <circle cx="270" cy="160" r="2" fill="currentColor" stroke="none" />
        <circle cx="282" cy="52" r="2" fill="currentColor" stroke="none" />
        <path d="M250 40 h18 M259 31 v18" />
      </g>
      <path d="M60 140 C 100 40, 160 40, 160 100 S 230 170, 262 60" stroke-width="2.5" />
      <g stroke-width="1" stroke-dasharray="3 3" opacity="0.6">
        <path d="M60 140 L100 40" /><path d="M160 100 L160 40" /><path d="M160 100 L160 160" /><path d="M262 60 L230 170" />
      </g>
      <g fill="var(--paper)" stroke-width="1.5">
        <rect x="55" y="135" width="10" height="10" /><rect x="155" y="95" width="10" height="10" /><rect x="257" y="55" width="10" height="10" />
      </g>
      <g fill="currentColor" stroke="none">
        <circle cx="100" cy="40" r="3.5" /><circle cx="160" cy="40" r="3.5" /><circle cx="160" cy="160" r="3.5" /><circle cx="230" cy="170" r="3.5" />
      </g>
    </g>
  )}

  {art === 'ux' && (
    <g class="fitts" fill="none" stroke="currentColor">
      <circle cx="226" cy="96" r="46" stroke-width="1.5" />
      <circle cx="226" cy="96" r="30" stroke-width="1" opacity="0.5" />
      <circle cx="226" cy="96" r="14" fill="currentColor" stroke="none" />
      <circle cx="104" cy="152" r="9" stroke-width="1.5" />
      <circle cx="128" cy="44" r="5" stroke-width="1.5" />
      <path d="M62 112 Q 140 70, 196 92" stroke-width="1" stroke-dasharray="4 4" opacity="0.6" />
      <g class="cursor">
        <path d="M52 96 l0 32 l8 -8 l6 13 l6 -3 l-6 -12 l11 0 z" fill="var(--paper)" stroke-width="1.5" stroke-linejoin="round" />
      </g>
    </g>
  )}

  {art === 'agency' && (
    <g class="agency">
      <rect x="38" y="32" width="244" height="136" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" opacity="0.45" />
      {grid.map((d) => <circle cx={d.x} cy={d.y} r="2" fill="currentColor" opacity="0.3" />)}
      <g class="escape" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M76 156 L292 14" />
        <path d="M268 14 L292 14 L286 37" />
      </g>
      <circle cx="76" cy="156" r="5" fill="currentColor" />
    </g>
  )}

  {art === 'electric' && (
    <g class="electric">
      <g class="wave-track"><path d={wave} fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.55" /></g>
      {[0, 1, 2, 3].map((i) => (
        <g transform={`translate(${78 + i * 44} 0)`}>
          <rect x="0" y="56" width="32" height="96" rx="5" fill="var(--paper)" stroke="currentColor" stroke-width="1.5" />
          <rect x="10" y="49" width="12" height="7" fill="currentColor" />
          <rect class="charge" style={`--i:${i}`} x="5" y={62 + (3 - i) * 14} width="22" height={84 - (3 - i) * 14} rx="2" fill="currentColor" opacity={0.25 + i * 0.2} />
        </g>
      ))}
    </g>
  )}

  {art === 'sea-power' && (
    <g class="sea">
      <defs>
        <clipPath id="land-clip"><path d="M168 0 C 150 40, 196 70, 176 110 S 200 170, 186 200 L320 200 L320 0 Z" /></clipPath>
      </defs>
      <g class="waves" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5">
        {[30, 54, 78, 102, 126, 150, 174].map((y, i) => (
          <path d={`M${-20 + (i % 2) * 12} ${y} q 10 -6 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0`} />
        ))}
      </g>
      <g clip-path="url(#land-clip)">
        <rect x="150" y="0" width="170" height="200" fill="var(--paper)" />
        <g fill="none" stroke="currentColor" stroke-width="1" opacity="0.45">
          <ellipse cx="262" cy="96" rx="80" ry="64" />
          <ellipse cx="262" cy="96" rx="58" ry="44" />
          <ellipse cx="266" cy="94" rx="36" ry="26" />
          <ellipse cx="268" cy="92" rx="14" ry="10" />
        </g>
      </g>
      <path d="M168 0 C 150 40, 196 70, 176 110 S 200 170, 186 200" fill="none" stroke="currentColor" stroke-width="2.5" />
      <path d="M30 172 C 90 150, 120 60, 150 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 5" />
      <g class="ship"><path d="M138 30 l14 0 l-3 6 l-8 0 z M145 30 l0 -12 l7 8 z" fill="currentColor" /></g>
      <rect x="262" y="86" width="12" height="12" fill="currentColor" transform="rotate(45 268 92)" />
    </g>
  )}
  {art === 'omarchy' && (
    <g class="omarchy">
      <path class="echo" d={OMARCHY} fill="currentColor" />
      <path d={OMARCHY} fill="var(--paper)" fill-rule="evenodd" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter" />
    </g>
  )}

  {art === 'sunrise' && (
    <g class="sunrise">
      <defs><clipPath id="horizon-clip"><rect x="0" y="0" width="320" height="140" /></clipPath></defs>
      <g clip-path="url(#horizon-clip)">
        <g class="sun">
          <circle cx="160" cy="146" r="88" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 5" opacity="0.4" />
          <circle cx="160" cy="146" r="62" fill="none" stroke="currentColor" stroke-width="1" opacity="0.45" />
          <circle cx="160" cy="146" r="34" fill="currentColor" />
        </g>
      </g>
      <path d="M20 140 H300" stroke="currentColor" stroke-width="1.5" />
      <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.45">
        <path d="M128 152 H192 M138 162 H182 M148 172 H172 M156 182 H164" />
      </g>
    </g>
  )}
</svg>
<style>
  .art { display: block; width: 100%; height: 100%; color: var(--ink); overflow: visible; }
  .art :global(*) { transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 300ms ease-out; }

  /* Hover moves. :global() because the hovered card lives in the page. */
  .sw { transform-box: fill-box; transform-origin: 50% 100%; }
  :global(.book:hover) .sw-1, :global(.book:focus-visible) .sw-1 { transform: rotate(-9deg) translateX(-8px); }
  :global(.book:hover) .sw-3, :global(.book:focus-visible) .sw-3 { transform: rotate(9deg) translateX(8px); }

  .gen-1 { transform-box: view-box; }
  :global(.book:hover) .gen-1, :global(.book:focus-visible) .gen-1 { transform: translateY(-3px); }
  :global(.book:hover) .gen-2, :global(.book:focus-visible) .gen-2 { transform: translateY(-6px); }

  .pulse { opacity: 0; }
  :global(.book:hover) .pulse, :global(.book:focus-visible) .pulse { opacity: 1; animation: pulse 1.2s linear infinite; }
  @keyframes pulse { to { stroke-dashoffset: -48; } }

  :global(.book:hover) .sat, :global(.book:focus-visible) .sat { transform: translate(14px, -6px) rotate(3deg); }

  .qr-dot { transform-box: fill-box; transform-origin: center; transition-delay: calc(var(--i) * 25ms); }
  :global(.book:hover) .qr-dot, :global(.book:focus-visible) .qr-dot { transform: scale(1.3); }

  :global(.book:hover) .cruft, :global(.book:focus-visible) .cruft { opacity: 0; }

  :global(.book:hover) .cursor, :global(.book:focus-visible) .cursor { transform: translate(160px, -14px); }

  .escape { transform-box: view-box; }
  :global(.book:hover) .escape, :global(.book:focus-visible) .escape { transform: translate(8px, -5px); }

  :global(.book:hover) .wave-track, :global(.book:focus-visible) .wave-track { transform: translateX(-25px); }
  .charge { transform-box: fill-box; transform-origin: 50% 100%; transition-delay: calc(var(--i) * 60ms); }
  :global(.book:hover) .charge, :global(.book:focus-visible) .charge { transform: scaleY(1.12); }

  :global(.book:hover) .waves, :global(.book:focus-visible) .waves { transform: translateX(-20px); }
  :global(.book:hover) .ship, :global(.book:focus-visible) .ship { transform: translate(-10px, 8px); }

  .echo { opacity: 0; }
  :global(.book:hover) .echo, :global(.book:focus-visible) .echo { opacity: 0.18; transform: translate(5px, 5px); }

  :global(.book:hover) .sun, :global(.book:focus-visible) .sun { transform: translateY(-14px); }

  @media (prefers-reduced-motion: reduce) {
    .art :global(*) { transition: none; animation: none !important; }
  }
</style>
