---
import SocialLinks from './SocialLinks.astro';
import { SITE } from '../data/site';
---
<footer class="wide-width">
  <SocialLinks />
  <p class="label">© {new Date().getFullYear()} {SITE.name}</p>
</footer>
<style>
  footer { width: 100%; margin-top: auto; padding-block: 32px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; border-top: 1px solid var(--rule); }
</style>
