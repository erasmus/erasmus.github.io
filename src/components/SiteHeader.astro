---
import { SITE } from '../data/site';
---
<header class="wide-width">
  <a class="site-name" href="/">{SITE.name}</a>
  <nav aria-label="Site">
    <a href="/#projects">Projects</a>
    <a href="/writing/">Writing</a>
    <a href="/#cv">CV</a>
    <a href="/#contact">Contact</a>
  </nav>
</header>
<style>
  header { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px 16px; padding-block: 24px; width: 100%; }
  .site-name { font-family: var(--font-sans); font-weight: 600; text-transform: uppercase; font-size: 16px; text-decoration: none; }
  nav { display: flex; gap: 16px; }
  nav a { font-family: var(--font-sans); font-size: 13px; text-decoration: none; color: var(--ink-muted); }
  nav a:hover { color: var(--ink); }
</style>
