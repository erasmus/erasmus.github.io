---
<ul class="social">
  {SITE.social.map((s) => (
    <li>
      <a href={s.url} title={s.label}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={ICONS[s.label]} /></svg>
        <span>{s.label}</span>
      </a>
    </li>
  ))}
</ul>
<style>
  .social { list-style: none; padding: 0; display: flex; gap: 20px; }
  .social a { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-sans); font-size: 13px; text-decoration: none; }
  .social a:hover { text-decoration: underline; }
</style>
