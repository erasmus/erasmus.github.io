---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`Writing — ${SITE.name}`} description="Essays on trust, technology, and transcendence.">
  <div class="prose-width">
    <h1>Writing</h1>
    <ul>
      {posts.map((post) => (
        <li>
          <p class="label"><time datetime={post.data.date.toISOString().slice(0, 10)}>{post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>
          <h2><a href={`/${post.data.date.getUTCFullYear()}/${post.id}/`}>{post.data.title}</a></h2>
          <p class="desc">{post.data.description}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  h1 { font-size: 2.2rem; margin-block: 24px 8px; }
  ul { list-style: none; padding: 0; }
  li { padding-block: 1.4em; border-bottom: 1px solid var(--rule); }
  li h2 { font-size: 1.4rem; margin-top: 2px; }
  li h2 a { text-decoration: none; }
  li h2 a:hover { text-decoration: underline; }
  .desc { color: var(--ink-muted); font-size: 0.95rem; margin-top: 4px; }
</style>
